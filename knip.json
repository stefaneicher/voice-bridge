{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bin/*.js",
    "scripts/*.mjs",
    "src/renderer/main.ts",
    "test/**/*.test.ts",
    "test/e2e/**/*.e2e.ts"
  ],
  "project": ["src/**/*.{ts,svelte}", "test/**/*.ts", "bin/*.js", "scripts/*.mjs"],
  "ignoreDependencies": ["node-pty", "uiohook-napi"],
  "ignoreExportsUsedInFile": true
}
